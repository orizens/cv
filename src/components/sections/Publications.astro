---
import SectionTitle from "../ui/SectionTitle.astro";
import type { Publication } from "../../types/cv";

interface Props {
  publications: Publication[];
}
const { publications } = Astro.props;
---

<div>
  <SectionTitle icon="book" title="Publications" />
  <div
    class="pb-5 relative w-auto bg-cv-box-bg rounded-[10px] border-b border-cv-box-border p-8 print:p-0 print:bg-transparent print:border-none print:rounded-none print:mb-10px"
  >
    {
      publications.map(({ href, image, imageAlt }) => (
        <div class="w-auto text-center xs:bg-white xs:rounded xs:p-4 xs:block xs:mx-auto xs:w-max xs:max-w-full print:text-center print:bg-transparent print:p-0 print:m-0 print:border-0">
          <a href={href} target="_blank">
            <img
              src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/${image}`}
              class="h-auto max-h-[250px] max-w-full"
              alt={imageAlt}
            />
          </a>
        </div>
      ))
    }
  </div>
</div>
