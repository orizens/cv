---
const year = new Date().getFullYear();
const footerBg = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/images/footer.png`;
---

<footer
  class="cv-footer print-hide"
  style={`background-image: linear-gradient(rgba(2, 8, 23, 0.82), rgba(2, 8, 23, 0.88)), url(${footerBg});`}
>
  <p>© {year} Oren Farhi — Built with Astro.</p>
</footer>
