---
import Icon from "@components/ui/Icon.astro";
import type { Skills } from "../../types/cv";

interface Props {
  skills: Skills;
}
const { skills } = Astro.props;

const libraryNames = new Set(skills.libraries);
const architectureLibs = ["Redux Toolkit", "NgRx"].filter((s) =>
  libraryNames.has(s),
);
const frameworkLibs = skills.libraries.filter(
  (s) => !architectureLibs.includes(s),
);

const groups: { label: string; items: string[] }[] = [
  { label: "Architecture", items: ["Architecture", ...architectureLibs] },
  { label: "Core Technologies", items: skills.languages },
  {
    label: "Frameworks & Platforms",
    items: [...frameworkLibs, ...skills.frameworks],
  },
  { label: "Engineering Quality", items: skills.testing },
  {
    label: "Leadership & Developer Experience",
    items: skills.other.filter((s) => s !== "Architecture"),
  },
  { label: "AI-Assisted Engineering", items: skills.ai },
];
---

<div class="card" id="skills">
  <h2 class="card-title">
    <Icon icon="brain" isLa />
    Skills
  </h2>
  {
    groups.map(({ label, items }) => (
      <div class="skill-group">
        <p class="skill-group-label">{label}</p>
        <div class="skill-tags">
          {items.map((skill) => (
            <span class="skill-tag">{skill}</span>
          ))}
        </div>
      </div>
    ))
  }
</div>
