---
import SectionTitle from "../ui/SectionTitle.astro";
import SkillTag from "../ui/SkillTag.astro";
import type { Skills } from "../../types/cv";

interface Props {
  skills: Skills;
}
const { skills } = Astro.props;

const groups: { label: string; items: string[] }[] = [
  { label: "Languages", items: skills.languages },
  { label: "Ai Code Assitants", items: skills.ai },
  { label: "Libraries", items: skills.libraries },
  { label: "Frameworks", items: skills.frameworks },
  { label: "Testing", items: skills.testing },
];
---

<div>
  <SectionTitle icon="code" title="My Skills" />
  <div
    class="pb-5 relative w-auto bg-cv-box-bg rounded-[10px] border-b border-cv-box-border p-8 print:p-0 print:bg-transparent print:border-none print:rounded-none print:mb-10px"
  >
    {
      groups.map(({ label, items }) => (
        <div>
          <h2 class="text-para-default uppercase m-0 print:text-black print:text-sm print:font-bold">
            {label}
          </h2>
          <div class="mb-2.5 flex flex-wrap gap-1.5">
            {items.map((skill) => (
              <SkillTag label={skill} />
            ))}
          </div>
        </div>
      ))
    }
    <div class="mb-2.5 flex flex-wrap gap-1.5">
      {skills.other.map((skill) => <SkillTag label={skill} />)}
    </div>
  </div>
</div>
