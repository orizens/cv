---
import Icon from "../ui/Icon.astro";
import type { Contact } from "../../types/cv";

interface Props {
  contact: Contact;
}
const { contact } = Astro.props;
---

<div
  id="contact-info"
  class="text-cv-light relative m-0 text-center sm:absolute sm:right-4 sm:top-3 print:static print:text-left print:m-0 print:col-span-2 print:mt-2"
>
  <ul
    class="pl-0 m-0 list-none leading-relaxed sm:text-xl print:text-sm"
    id="contact-list"
  >
    {
      contact.links.map(({ href, icon, text, isLa }) => (
        <li>
          <a href={href} class="text-cv-light no-underline print:text-black">
            <Icon icon={icon} isLa={isLa} />
            {text}
          </a>
        </li>
      ))
    }
    {
      contact.phones.map((phone) => (
        <li>
          <Icon icon="phone" isLa />
          <strong class="print:text-black">{phone}</strong>
        </li>
      ))
    }
  </ul>
</div>
