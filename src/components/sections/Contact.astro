---
import Icon from "../ui/Icon.astro";
import type { Contact } from "../../types/cv";

interface Props {
  contact: Contact;
}
const { contact } = Astro.props;
---

<div id="contact-info">
  <ul class="list-unstyled" id="contact-list">
    {
      contact.links.map(({ href, icon, text, isLa }) => (
        <li>
          <a href={href} class="unstyled-links">
            <Icon icon={icon} isLa={isLa} />
            {text}
          </a>
        </li>
      ))
    }
    {
      contact.phones.map((phone) => (
        <li>
          <Icon icon="phone" isLa />
          <strong>{phone}</strong>
        </li>
      ))
    }
  </ul>
</div>
