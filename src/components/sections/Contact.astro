---
import type { Contact, SocialLink } from "../../types/cv";

interface Props {
  contact: Contact;
  social: SocialLink[];
}
const { contact, social } = Astro.props;

// Get email and website from contact
const email = contact.links.find((link) => link.href.startsWith("mailto:"));
const website = contact.links.find((link) => !link.href.startsWith("mailto:"));

// Get LinkedIn from social
const linkedin = social.find((link) => link.href.includes("linkedin"));

// Get first phone number
const phone = contact.phones[0];
---

<div
  class="grid gap-x-8 gap-y-1 mt-5 text-xs"
  style="grid-template-columns:1fr 1fr;"
>
  {
    email && (
      <a
        href={email.href}
        class="border-b border-border no-underline text-paper print:text-gray-600 hover:text-cv-highlight hover:border-cv-highlight transition-colors"
      >
        {email.text}
      </a>
    )
  }
  {
    website && (
      <a
        href={website.href}
        class="border-b border-border no-underline text-paper print:text-gray-600 hover:text-cv-highlight hover:border-cv-highlight transition-colors"
      >
        {website.text}
      </a>
    )
  }
  <span class="text-paper print:text-gray-600">{phone}</span>
  {
    linkedin && (
      <a
        href={linkedin.href}
        class="border-b border-border no-underline text-paper print:text-gray-600 hover:text-cv-highlight hover:border-cv-highlight transition-colors"
      >
        {linkedin.text}
      </a>
    )
  }
</div>
