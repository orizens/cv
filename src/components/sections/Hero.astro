---
import Icon from "@components/ui/Icon.astro";
import type { UserProfile, SocialLink } from "../../types/cv";

interface Props {
  profile: UserProfile;
  social: SocialLink[];
}
const { profile, social } = Astro.props;
const [firstName, lastName] = profile.name.split(" ");
---

<div class="person">
  <img src={profile.avatarUrl} alt={profile.name} />
  <h1 class="my-name"><span>{firstName}</span>{lastName}</h1>
  <h2>{profile.title}</h2>
  <ul class="social-icons print-hide list-unstyled">
    {
      social.map(({ href, icon, isLa }) => (
        <li>
          <a
            href={href}
            class="unstyled-links"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon icon={icon} isLa={isLa} />
          </a>
        </li>
      ))
    }
  </ul>
</div>
