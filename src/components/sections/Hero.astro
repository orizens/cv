---
import type { UserProfile, SocialLink } from "../../types/cv";

interface Props {
  profile: UserProfile;
  social: SocialLink[];
}
const { profile, social } = Astro.props;
---

<div class="person">
  <img src={profile.avatarUrl} alt={profile.name} />
  <h1>{profile.name}</h1>
  <h2>{profile.title}</h2>
  <ul class="social-icons list-unstyled">
    {social.map(({ href, icon }) => (
      <li>
        <a href={href} class="unstyled-links" target="_blank" rel="noopener noreferrer">
          <span class={`fa fa-${icon}`}></span>
        </a>
      </li>
    ))}
  </ul>
</div>
