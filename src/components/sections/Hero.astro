---
import type { UserProfile } from "../../types/cv";

interface Props {
  profile: UserProfile;
}
const { profile } = Astro.props;

// Split name into first and last for styling
const nameParts = profile.name.split(" ");
const firstName = nameParts.slice(0, -1).join(" ");
const lastName = nameParts[nameParts.length - 1];
---

<div>
  <h1
    class="font-serif text-6xl font-black leading-none tracking-tight text-ink"
  >
    <span class="text-paper print:text-gray-600">{firstName}</span>
    <em class="italic text-cv-highlight">{lastName}</em>
  </h1>
  <span
    class="inline-block mt-2 font-mono font-medium tracking-widest uppercase text-paper py-1"
  >
    {profile.title}
  </span>
</div>
