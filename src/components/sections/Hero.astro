---
import Icon from "@components/ui/Icon.astro";
import PrintMenu from "@components/ui/PrintMenu.astro";
import type { UserProfile, SocialLink } from "../../types/cv";

interface Props {
  profile: UserProfile;
  social: SocialLink[];
}
const { profile, social } = Astro.props;

const primarySocial = social.filter((s) =>
  ["link", "github-alt", "linkedin"].includes(s.icon),
);

const heroBg = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/images/header-new.png`;
const avatarImg = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/images/avatar.png`;

const nameParts = profile.name.trim().split(/\s+/);
const lastName = nameParts.pop();
const firstNames = nameParts.join(" ");
---

<section
  class="hero print-hide"
  id="hero"
  style={`background-image: url(${heroBg});`}
>
  <span class="hero-starfield" aria-hidden="true"></span>
  <span class="hero-glow" aria-hidden="true"></span>
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-eyebrow">Online Résumé</p>
      <h1 class="hero-name">
        {firstNames && `${firstNames} `}
        <span class="brand-text">{lastName}</span>
      </h1>
      <p class="hero-title">{profile.title}</p>
      {profile.subtitle && <p class="hero-subtitle">{profile.subtitle}</p>}
      <p class="hero-lede">
        I design and build AI-powered products end-to-end - LLM features and
        on-device ML, design systems, and React &amp; TypeScript interfaces
        backed by testing that lets teams ship with confidence.
      </p>
      <div class="hero-actions">
        <a href="#work-experience" class="btn btn-primary">
          <Icon icon="arrow-down" isLa />
          View Experience
        </a>
        <PrintMenu />
      </div>
      <ul class="hero-social list-unstyled">
        {primarySocial.map(({ href, icon, text, isLa }) => (
          <li>
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={text}
              class={icon === "link" ? "hero-social-site" : undefined}
            >
              <Icon icon={icon} isLa={isLa} />
              {icon === "link" && <span>{text}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="hero-visual">
      <div class="hero-avatar-wrap">
        <span class="hero-avatar-glow" aria-hidden="true"></span>
        <img class="hero-avatar" src={avatarImg} alt="" loading="eager" />
      </div>
    </div>
  </div>
</section>
