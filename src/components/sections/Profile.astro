---
import type { UserProfile } from "../../types/cv";

interface Props {
  profile: UserProfile;
}
const { profile } = Astro.props;

---

<section class="profile-section" id="profile">
  <span class="section-eyebrow">Profile</span>
  <h2 class="section-heading">Summary</h2>
  <ul class="summary-list">
    {profile.summary.map((p) => <li set:html={p} />)}
  </ul>
  <div class="profile-callout">
    {profile.cofounding.description}{" "}
    <a href={profile.cofounding.url} target="_blank" rel="noopener noreferrer"
      >{profile.cofounding.label}</a
    >
  </div>
</section>
