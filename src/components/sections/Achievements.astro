---
import Icon from "@components/ui/Icon.astro";
import type { Achievement } from "../../types/cv";

interface Props {
  achievements: Achievement[];
}
const { achievements } = Astro.props;
---

<div class="card">
  <h2 class="card-title">
    <Icon icon="award" isLa />
    Achievements
  </h2>
  <ul class="achievements-list text-sm list-unstyled">
    {
      achievements.map(({ title, description, href, badge, details }) => (
        <li class="achievement-item">
          {href ? (
            <a href={href} class="unstyled-links" target="_blank" rel="noopener noreferrer">
              <strong>{title}</strong>
            </a>
          ) : (
            <strong>{title}</strong>
          )}
          {description && <em>{description}</em>}
          {badge && (
            <div class="achievement-badge mt-2">
              <img src={badge} alt="npm downloads" class="inline-block" />
            </div>
          )}
          {details &&
            details.map((detail) => (
              <div class="achievement-detail mt-2">{detail}</div>
            ))}
        </li>
      ))
    }
  </ul>
</div>
