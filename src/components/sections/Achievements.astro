---
import SectionTitle from "../ui/SectionTitle.astro";
import type { Achievement } from "../../types/cv";

interface Props {
  achievements: Achievement[];
}
const { achievements } = Astro.props;
---

<div>
  <SectionTitle icon="trophy" title="Achievements" />
  <div
    class="pb-5 relative w-auto bg-cv-box-bg rounded-[10px] border-b border-cv-box-border p-8 print:p-0 print:bg-transparent print:border-none print:rounded-none print:mb-10px"
  >
    <ul class="pl-0 m-0 list-none leading-relaxed text-[0.9rem] print:text-sm">
      {
        achievements.map(({ title, description, href, badge, details }) => (
          <li class="mb-4">
            {href ? (
              <a
                href={href}
                class="text-cv-highlight no-underline print:text-black"
                target="_blank"
              >
                <strong>{title}</strong>
              </a>
            ) : (
              <strong>{title}</strong>
            )}
            {description && (
              <div>
                <em>{description}</em>
              </div>
            )}
            {badge && (
              <div class="mt-2 print:hidden">
                <img src={badge} alt="npm downloads" class="inline-block" />
              </div>
            )}
            {details &&
              details.map((detail) => <div class="mt-3">{detail}</div>)}
          </li>
        ))
      }
    </ul>
  </div>
</div>
