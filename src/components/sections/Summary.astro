---
import SectionTitle from '../ui/SectionTitle.astro';
import type { Profile } from '../../types/cv';

interface Props {
  profile: Profile;
}
const { profile } = Astro.props;
---
<div class="cv-section">
  <SectionTitle icon="user" title="Summary" />
  <div class="item">
    <p set:html={profile.summary} />
    <p>
      {profile.cofounding.description}{' '}
      <a href={profile.cofounding.url} target="_blank">"{profile.cofounding.label}"</a>
    </p>
  </div>
</div>
