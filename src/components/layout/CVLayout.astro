---
import "../../styles/base.css";
import PlanetIcon from "@components/ui/PlanetIcon.astro";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  jsonLd?: object;
}
const {
  title = ":: Oren Farhi's CV / RESUME ::",
  description = "Oren Farhi's CV Front End Architect",
  keywords = "cv, front end, architect, javascript",
  jsonLd,
} = Astro.props;
---

<html>
  <head>
    <title>{title}</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />

    <PlanetIcon />
    <link
      href="//fonts.googleapis.com/css?family=Open+Sans:300"
      rel="stylesheet"
      type="text/css"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/line-awesome/1.3.0/line-awesome/css/line-awesome.min.css"
    />
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
