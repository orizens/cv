---
import type { ProjectEntry } from "../../types/cv";

interface Props {
  title: string;
  items: ProjectEntry[];
  icon: string;
  highlight?: boolean;
}
const { title, items, icon, highlight = false } = Astro.props;

function renderLabel(name: string, link?: string) {
  return link ? `<a href="${link}">${name}</a>` : name;
}
---

{
  title && items.length > 0 && (
    <div>
      <h3 class="print:text-sm print:font-bold">{title}</h3>
      <ul class="pl-0 m-0 list-none leading-relaxed print:text-sm">
        {items.map(([name, desc, link]) => (
          <li>
            <span class={`las la-${icon} mr-1.5`} />
            {highlight ? (
              <span
                class="text-cv-highlight font-bold print:text-black"
                set:html={renderLabel(name, link)}
              />
            ) : (
              name
            )}{" "}
            - <span set:html={desc} />
          </li>
        ))}
      </ul>
    </div>
  )
}
