---
import type { ProjectEntry } from "../../types/cv";
import Icon from "./Icon.astro";

interface Props {
  title: string;
  items: ProjectEntry[];
  icon: string;
  highlight?: boolean;
}
const { title, items, icon, highlight = false } = Astro.props;

function renderLabel(name: string, link?: string) {
  return link ? `<a href="${link}">${name}</a>` : name;
}
---

{
  title && items.length > 0 && (
    <div>
      <h3>{title}</h3>
      <ul class="list-unstyled">
        {items.map(([name, desc, link]) => (
          <li>
            <Icon icon={icon} isLa />
            {highlight ? (
              <span class="item-client" set:html={renderLabel(name, link)} />
            ) : (
              name
            )}{" "}
            - <span set:html={desc} />
          </li>
        ))}
      </ul>
    </div>
  )
}
