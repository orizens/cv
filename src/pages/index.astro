---
import CVLayout from "../components/layout/CVLayout.astro";
import Hero from "../components/sections/Hero.astro";
import Contact from "../components/sections/Contact.astro";
import Profile from "../components/sections/Profile.astro";
import Experience from "../components/sections/Experience.astro";
import Skills from "../components/sections/Skills.astro";
import Achievements from "../components/sections/Achievements.astro";
import Publications from "../components/sections/Publications.astro";
import Education from "../components/sections/Education.astro";
import Social from "../components/sections/Social.astro";

import profile from "../data/profile.json";
import contact from "../data/contact.json";
import experience from "../data/experience.json";
import skills from "../data/skills.json";
import achievements from "../data/achievements.json";
import publications from "../data/publications.json";
import education from "../data/education.json";
import social from "../data/social.json";

import type {
  UserProfile,
  Contact as ContactType,
  ExperienceItem,
  Skills as SkillsType,
  Achievement,
  Publication,
  EducationItem,
  SocialLink,
} from "../types/cv";

const allSkills = [
  ...(skills as SkillsType).languages,
  ...(skills as SkillsType).libraries,
  ...(skills as SkillsType).frameworks,
  ...(skills as SkillsType).testing,
  ...(skills as SkillsType).other,
];

const achievements_data = achievements as Achievement[];
const book = achievements_data.find((a) => a.title.includes("Author"));
const npmModule = achievements_data.find((a) => a.title.includes("ngx-infinite-scroll"));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: (profile as UserProfile).name,
  jobTitle: (profile as UserProfile).title,
  description: "Principal / Staff Frontend Engineer and UI Architect with 20+ years of experience in frontend architecture, developer experience, testing infrastructure and technical leadership.",
  email: (contact as ContactType).links.find((l) => l.href.startsWith("mailto:"))?.text,
  telephone: (contact as ContactType).phones,
  url: "https://orencv.netlify.app",
  image: `https:${(profile as UserProfile).avatarUrl}`,
  sameAs: (social as SocialLink[]).map((s) => s.href.startsWith("//") ? `https:${s.href}` : s.href),
  knowsAbout: allSkills,
  hasOccupation: (experience as unknown as ExperienceItem[]).map((e) => ({
    "@type": "Role",
    roleName: e.role,
    startDate: e.date.split(" - ")[0],
    endDate: e.date.includes("Present") ? undefined : e.date.split(" - ")[1],
    worksFor: { "@type": "Organization", name: e.company },
    description: e.tagline,
  })),
  alumniOf: (education as EducationItem[]).map((e) => ({
    "@type": "EducationalOrganization",
    name: e.institution,
    description: `${e.degree}, ${e.years}`,
  })),
  author: book ? [{ "@type": "Book", name: book.title.replace("Author of ", ""), url: book.href }] : undefined,
  award: npmModule ? [{
    "@type": "CreativeWork",
    name: npmModule.title,
    description: npmModule.description,
    url: npmModule.href,
    additionalProperty: npmModule.details ? { "@type": "PropertyValue", name: "usage", value: npmModule.details.join(", ") } : undefined,
  }] : undefined,
};
---

<CVLayout jsonLd={jsonLd}>
  <div class="first-cv-section">
    <Hero profile={profile as UserProfile} social={social as SocialLink[]} />
    <Contact contact={contact as ContactType} />
  </div>

  <div class="cv-contents">
    <section class="profile">
      <Profile profile={profile as UserProfile} />
      <Experience experience={experience as unknown as ExperienceItem[]} />
    </section>

    <section class="skills">
      <Skills skills={skills as SkillsType} />
      <Achievements achievements={achievements as Achievement[]} />
      <Publications publications={publications as Publication[]} />
      <Social social={social as SocialLink[]} />
      <Education education={education as EducationItem[]} />
    </section>
  </div>
</CVLayout>
